// Cloudflare Workers Builds deploys this site as static assets only:
// no Worker script runs, the files in dist/ are served as built.
{
  "name": "chikox-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
