---
import Pipeline from '../Pipeline.astro';
import Screenshots from '../Screenshots.astro';
import SystemCards from '../SystemCards.astro';
import { pathFor, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const h = t(locale).home;
---

<section class="hero">
  <div class="wrap">
    <span class="eyebrow">{h.eyebrow}</span>
    <h1>{h.title}</h1>
    <p class="lead">{h.lead}</p>
    <div class="actions">
      <a class="btn btn-primary" href={pathFor(locale, 'platform')}>{h.primaryCta}</a>
      <a class="btn btn-secondary" href={pathFor(locale, 'sensors')}>{h.secondaryCta}</a>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="systems">
  <div class="wrap">
    <h2 id="systems">{h.systemsTitle}</h2>
    <p class="lead">{h.systemsLead}</p>
    <SystemCards locale={locale} />
  </div>
</section>

<section class="section" aria-labelledby="how">
  <div class="wrap">
    <h2 id="how">{h.flowTitle}</h2>
    <p class="lead">{h.flowLead}</p>
    <Pipeline id="flow" pipeline={h.flow} />
    <Screenshots locale={locale} route="home" />
  </div>
</section>

<section class="section" aria-labelledby="principles">
  <div class="wrap">
    <h2 id="principles">{h.principlesTitle}</h2>
    <div class="grid grid-2">
      {
        h.principles.map((p) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section" aria-labelledby="sensors">
  <div class="wrap teaser">
    <div>
      <h2 id="sensors">{h.sensorsTitle}</h2>
      <p class="prose">{h.sensorsBody}</p>
      <a href={pathFor(locale, 'sensors')}>{h.sensorsCta} →</a>
    </div>
    <svg class="teaser-art" viewBox="0 0 200 140" aria-hidden="true" focusable="false">
      <circle class="d-radio" cx="100" cy="100" r="28"></circle>
      <circle class="d-radio" cx="100" cy="100" r="52"></circle>
      <circle class="d-radio" cx="100" cy="100" r="76"></circle>
      <rect class="d-box-accent" x="86" y="88" width="28" height="24" rx="5"></rect>
      <line class="d-edge-accent" x1="100" y1="88" x2="100" y2="70"></line>
      <circle class="d-head-accent" cx="100" cy="68" r="3"></circle>
    </svg>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 0 3rem;
  }
  .hero h1 {
    max-width: 50rem;
  }
  .teaser {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .teaser {
      grid-template-columns: 2fr 1fr;
    }
  }
  .teaser-art {
    width: 100%;
    max-width: 16rem;
    justify-self: center;
  }
</style>
