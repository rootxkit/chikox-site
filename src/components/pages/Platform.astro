---
import Architecture from '../Architecture.astro';
import SystemCards from '../SystemCards.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const p = d.platform;
---

<header class="page-head">
  <div class="wrap">
    <h1>{p.title}</h1>
    <p class="lead">{p.lead}</p>
  </div>
</header>

<section class="section" aria-labelledby="architecture">
  <div class="wrap">
    <h2 id="architecture">{p.architectureTitle}</h2>
    <Architecture labels={p.architecture} />
    <h3 class="flows-title">{p.architecture.flowsTitle}</h3>
    <ol class="flows prose">
      {p.architecture.flows.map((f) => <li>{f}</li>)}
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="systems">
  <div class="wrap">
    <h2 id="systems">{d.ui.systemsHeading}</h2>
    <SystemCards locale={locale} />
  </div>
</section>

<section class="section" aria-labelledby="scope">
  <div class="wrap grid grid-2">
    <div>
      <h2 id="scope">{p.doesTitle}</h2>
      <ul class="list-check">
        {p.does.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <h2 id="not">{p.doesNotTitle}</h2>
      <p class="muted">{p.doesNotLead}</p>
      <ul class="list-cross">
        {p.doesNot.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="shared">
  <div class="wrap">
    <h2 id="shared">{p.sharedTitle}</h2>
    <div class="grid grid-2">
      {
        p.shared.map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .flows-title {
    margin-top: 2rem;
  }
  .flows li::marker {
    color: var(--muted);
  }
</style>
